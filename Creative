function toggleMenu() { document.getElementById('sideNav').classList.toggle('active'); document.getElementById('overlay').classList.toggle('active'); }
function toggleDropdown() { 
    const drop = document.getElementById("categoryDrop"); 
    const caret = document.getElementById("caret");
    drop.style.display = (drop.style.display === "block") ? "none" : "block"; 
    caret.classList.toggle("rotate");
}
function openSoldPage() { toggleMenu(); document.getElementById('soldPage').style.display = 'block'; document.body.style.overflow = 'hidden'; }
function closeSoldPage() { document.getElementById('soldPage').style.display = 'none'; document.body.style.overflow = 'auto'; }

function openTCPage() { toggleMenu(); document.getElementById('tcPage').style.display = 'block'; document.body.style.overflow = 'hidden'; }
function closeTCPage() { document.getElementById('tcPage').style.display = 'none'; document.body.style.overflow = 'auto'; }

function openDetails(n, p) {
    const sum = n.replace(/\D/g, '').split('').reduce((a, b) => parseInt(a) + parseInt(b), 0);
    document.getElementById('modalExclusiveHead').innerText = `Exclusive ${n} - A Number to Remember!`;
    document.getElementById('modalNumber').innerText = n;
    document.getElementById('modalPrice').innerText = '₹' + p.toLocaleString('en-IN');
    document.getElementById('modalSum').innerText = sum;
    document.getElementById('detailsModal').classList.add('active');
}
function closeDetails() { document.getElementById('detailsModal').classList.remove('active'); }

function renderList() {
    const container = document.getElementById("results");
    const visibleItems = currentFilteredList.slice(0, itemsToShow);
    container.innerHTML = visibleItems.map(item => `
        <div class="card">
            <div class="number">${item.n}</div>
            <div class="new-p">₹${item.p.toLocaleString('en-IN')}</div>
            <div class="btn-group">
                <button onclick="openDetails('${item.n}', ${item.p})" class="action-btn btn-details">Details</button>
                <a href="https://wa.me/99999999" class="action-btn btn-buy">Buy Now</a>
            </div>
        </div>`).join('');
    document.getElementById("loadMoreContainer").style.display = (itemsToShow >= currentFilteredList.length) ? "none" : "block";
}

function loadMore() { itemsToShow += 15; renderList(); }
function resetAndFilter() { itemsToShow = 15; applyFilters(); }

function applyFilters() {
    const s = document.getElementById("search").value.replace(/\s/g, '');
    const min = parseFloat(document.getElementById("min").value) || 0;
    const max = parseFloat(document.getElementById("max").value) || Infinity;
    const sort = document.getElementById("sortPrice").value;
    const searchType = document.querySelector('input[name="searchType"]:checked').value;

    currentFilteredList = inventoryData.filter(i => {
        const cleanNum = i.n.replace(/\D/g, '');
        let matchesDigits = false;
        if (searchType === 'start') matchesDigits = cleanNum.startsWith(s);
        else if (searchType === 'end') matchesDigits = cleanNum.endsWith(s);
        else matchesDigits = cleanNum.includes(s);
        return matchesDigits && i.p >= min && i.p <= max;
    });

    if(sort === "lowHigh") currentFilteredList.sort((a,b) => a.p - b.p);
    if(sort === "highLow") currentFilteredList.sort((a,b) => b.p - a.p);
    renderList();
}

currentFilteredList = [...inventoryData];
renderList();
</script>
