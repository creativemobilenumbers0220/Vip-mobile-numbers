<style>
:root {
    --gold: #b8860b;
    --gold-gradient: linear-gradient(to right, #bf953f, #fcf6ba, #b38728, #fbf5b7, #aa771c);
    --white: #ffffff;
    --light-grey: #f9f9f9;
    --dark-text: #1a1a1a;
    --border: #e0e0e0;
}

body { margin: 0; font-family: 'Segoe UI', system-ui, sans-serif; background: var(--white); color: var(--dark-text); overflow-x: hidden; }

/* --- SIDE MENU --- */
.menu-btn { position: absolute; left: 20px; top: 38px; cursor: pointer; z-index: 1002; display: flex; flex-direction: column; gap: 4px; }
.menu-btn div { width: 5px; height: 5px; background-color: var(--gold); border-radius: 50%; }
.side-nav { position: fixed; top: 0; left: -100%; width: 280px; height: 100%; background: var(--white); z-index: 1000; transition: 0.4s ease; padding-top: 60px; border-right: 1px solid var(--gold); overflow-y: auto; }
.side-nav.active { left: 0; }
.side-nav a, .dropdown-btn { display: block; padding: 15px 30px; text-decoration: none; color: var(--dark-text); font-size: 16px; border-bottom: 1px solid var(--light-grey); font-weight: 500; width: 100%; text-align: left; background: none; cursor: pointer; border: none; }
.dropdown-container { display: none; background-color: #fcfcfc; }
.dropdown-container a { padding-left: 50px; font-size: 14px; border-bottom: 1px solid #f1f1f1; color: #555; }
.caret-icon { float: right; transition: 0.3s; font-size: 10px; margin-top: 5px; }
.rotate { transform: rotate(180deg); }
.side-nav .menu-section { padding: 20px 30px 10px; font-size: 12px; text-transform: uppercase; color: var(--gold); letter-spacing: 1.5px; font-weight: bold; }
.overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); display: none; z-index: 999; }
.overlay.active { display: block; }

/* --- RECENTLY SOLD & T&C PAGE --- */
#soldPage, #tcPage {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: white; z-index: 3000; display: none; overflow-y: auto;
    padding: 80px 20px 40px;
}
.sold-header, .tc-header { position: fixed; top: 0; left: 0; width: 100%; background: white; padding: 20px; border-bottom: 1px solid var(--gold); text-align: center; font-family: 'Playfair Display', serif; font-size: 20px; font-weight: bold; z-index: 3001; }
.close-sold, .close-tc { position: absolute; left: 20px; top: 20px; font-size: 24px; cursor: pointer; }
.sold-item { padding: 20px; border: 1px solid #eee; border-radius: 10px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; max-width: 600px; margin-inline: auto; }
.sold-tag { background: #ffebee; color: #c62828; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; text-transform: uppercase; }

.tc-content { max-width: 600px; margin: 40px auto; line-height: 1.8; color: #444; font-size: 16px; }
.tc-content p { margin-bottom: 20px; padding: 15px; border-left: 4px solid var(--gold); background: #fffcf5; }

/* --- NAVBAR & HERO --- */
.navbar { padding: 25px 0; background: transparent; position: absolute; width: 100%; z-index: 10; text-align: center; display: flex; justify-content: center; align-items: center; }
.logo { font-size: 34px; letter-spacing: 4px; text-transform: uppercase; font-family: 'Playfair Display', serif; background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 700; position: relative; z-index: 1001; }
.hero { height: 60vh; background: url('https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?q=80&w=2000') center/cover no-repeat; display: flex; align-items: center; justify-content: flex-start; position: relative; padding-left: 8%; }
.hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.85) 30%, rgba(0,0,0,0.3) 100%); }
.hero-content { position: relative; z-index: 2; text-align: left; }
.since-badge { display: flex; align-items: center; gap: 10px; color: var(--gold); font-size: 12px; letter-spacing: 2px; margin-bottom: 15px; }
.since-badge::before { content: ""; width: 20px; height: 2px; background: var(--gold); }
.hero h1 { font-family: 'Montserrat', sans-serif; font-size: 3rem; color: #ffffff; text-transform: uppercase; margin: 0; font-weight: 700; line-height: 1.1; }
.hero h1 span { background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.sub-quote { color:#ccc; margin-top:10px; font-size: 1.1rem; letter-spacing: 1px; }

/* --- FILTERS & ROLLING BAR --- */
.filters { max-width: 800px; margin: 40px auto; padding: 0 20px; display: flex; flex-direction: column; gap: 15px; }

.search-row { display: flex; gap: 10px; align-items: stretch; }
.search-row input { flex: 3; padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 16px; min-width: 0; }
.btn-search { flex: 1; background: var(--dark-text); color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; flex-shrink: 0; white-space: nowrap; }

.search-type-row { display: flex; justify-content: center; gap: 20px; margin: 5px 0; }
.search-type-row label { display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer; font-weight: 500; }
.search-type-row input[type="radio"] { accent-color: var(--gold); transform: scale(1.1); }

/* UPDATED PRICE ROW FOR VERTICAL STACKING */
.price-row { display: flex; flex-direction: column; gap: 10px; }
.price-row input, .price-row select { 
    width: 100%; 
    padding: 12px; 
    border: 1px solid var(--border); 
    border-radius: 8px; 
    height: 48px; 
    box-sizing: border-box;
}
.btn-sell-now { 
    width: 100%; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    background: #000; 
    color: #fff; 
    font-weight: bold; 
    text-decoration: none; 
    border-radius: 8px; 
    text-transform: uppercase; 
    font-size: 14px; 
    text-align: center; 
    height: 48px; 
    box-sizing: border-box;
}

.sliding-numbers-bar { background: var(--white); overflow: hidden; white-space: nowrap; padding: 15px 0; border: 1px solid var(--border); border-radius: 8px; margin-top:20px; position: relative; }
.scroll-track { display: inline-block; animation: scrollLeft 20s linear infinite; }
.scroll-track-reverse { display: inline-block; animation: scrollRight 20s linear infinite; margin-top: 10px; border-top: 1px dashed var(--border); padding-top: 10px; }
.scroll-item { display: inline-flex; flex-direction: column; align-items: center; padding: 0 65px; font-weight: bold; font-size: 14px; }

@keyframes scrollLeft { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes scrollRight { from { transform: translateX(-50%); } to { transform: translateX(0); } }

/* --- GRID & CARDS --- */
.section-title { text-align: center; font-family: 'Playfair Display', serif; font-size: 28px; margin: 45px 0 25px; color: var(--dark-text); text-transform: uppercase; letter-spacing: 2px; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 25px; padding: 0 5% 30px; }
.card { border: 1px solid var(--gold); border-radius: 12px; padding: 25px; text-align: center; background: white; transition: 0.3s; position: relative; }
.number { font-size: 26px; font-weight: bold; margin-bottom: 20px; letter-spacing: 1px; }
.new-p { color: var(--gold); font-size: 22px; font-weight: bold; }
.btn-group { display: flex; gap: 10px; margin-top: 20px; }
.action-btn { text-decoration: none; padding: 12px; border-radius: 25px; font-weight: bold; flex: 1; text-align: center; border: none; font-size: 14px; cursor: pointer; }
.btn-details { background: #f0f0f0; color: #000; }
.btn-buy { background: #000; color: #fff; }

/* --- LOAD MORE --- */
.load-more-container { text-align: center; padding: 20px 0 60px; display: none; }
.btn-load-more { background: var(--white); color: var(--gold); border: 2px solid var(--gold); padding: 14px 45px; border-radius: 30px; font-weight: 700; cursor: pointer; text-transform: uppercase; }

/* --- TRUST POINTS --- */
.trust-points-section { padding: 60px 5%; background: #fff; text-align: center; border-top: 1px solid var(--border); }
.trust-row { display: flex; justify-content: center; gap: 15px; flex-wrap: nowrap; margin-top: 30px; overflow-x: auto; }
.trust-item { flex: 1; min-width: 150px; display: flex; flex-direction: column; align-items: center; padding: 10px; }
.icon-container { width: 70px; height: 70px; border: 2px solid #fcf6ba; background: #0d1e3e; border-radius: 50%; display: flex; justify-content: center; align-items: center; margin-bottom: 15px; }
.trust-icon-img { width: 30px; height: 30px; filter: brightness(0) invert(1); }

footer { text-align: center; padding: 40px 20px 60px; background: var(--light-grey); border-top: 1px solid var(--border); }

/* --- MODAL (POPUP) --- */
.modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 2000; display: none; align-items: center; justify-content: center; backdrop-filter: blur(5px); }
.modal.active { display: flex; }
.modal-content { max-width: 480px; width: 95%; background: #fff; border-radius: 15px; position: relative; overflow: hidden; animation: slideUp 0.3s ease-out; }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.modal-header { background: #f8f9fa; padding: 15px; border-bottom: 1px solid #eee; text-align: center; font-weight: bold; position: relative; }
.close-modal { position: absolute; top: 10px; right: 15px; font-size: 28px; cursor: pointer; color: #888; }
.modal-body { padding: 25px; text-align: center; }
.display-number { font-size: 2rem; font-weight: 800; margin-bottom: 10px; color: var(--dark-text); }
.display-price { font-size: 1.5rem; color: var(--gold); font-weight: 700; margin-bottom: 20px; }

.exclusive-list { text-align: left; margin: 20px 0; border-top: 1px solid #eee; padding-top: 15px; }
.exclusive-item { display: flex; align-items: center; gap: 10px; padding: 8px 0; font-size: 14px; color: #444; font-weight: 500; border-bottom: 1px dashed #f1f1f1; }
.exclusive-item b { color: #000; }

@media (max-width: 600px) {
    .logo { font-size: 22px; letter-spacing: 2px; }
    .hero h1 { font-size: 2rem; }
    .hero { height: auto; padding: 140px 5% 60px; }
    .menu-btn { top: 32px; }
}
</style>
